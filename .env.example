# Copy to .env and fill in. With no LLM_API_KEY the app runs in DEMO mode (sample itineraries).
# Any OpenAI-compatible chat-completions endpoint works. Pick ONE block.

# --- Groq (free tier, very fast) — https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# --- Google Gemini (free tier) — https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=

# --- OpenRouter (has free models) — https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=

# --- Ollama (local, free). Any non-empty key works.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Ask the provider for JSON mode (response_format). Leave off if your provider rejects it with streaming.
LLM_JSON_MODE=false

# Set to false in production to disable the failure-simulation panel's server hooks.
ALLOW_SIMULATE=true

# Port for the API server in development (Vite proxies /api to it).
API_PORT=8787
