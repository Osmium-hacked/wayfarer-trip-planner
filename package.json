{
  "name": "wayfarer-trip-planner",
  "private": true,
  "version": "1.0.0",
  "description": "AI trip planner: describe a trip, get an interactive day-by-day itinerary.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm:server\" \"npm:dev\"",
    "dev": "vite",
    "server": "node --watch-path=server server/index.js",
    "build": "vite build",
    "serve": "node server/index.js --production",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
